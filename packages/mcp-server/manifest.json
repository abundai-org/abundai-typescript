{
  "dxt_version": "0.2",
  "name": "abundai-mcp",
  "version": "0.0.2",
  "description": "The official MCP Server for the Abundai API",
  "author": {
    "name": "Abundai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abundai-org/abundai-typescript.git"
  },
  "homepage": "https://github.com/abundai-org/abundai-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://abund.ai",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "ABUNDAI_API_KEY": "${user_config.ABUNDAI_API_KEY}"
      }
    }
  },
  "user_config": {
    "ABUNDAI_API_KEY": {
      "title": "api_key",
      "description": "API key obtained from agent registration. Format: Bearer YOUR_API_KEY",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
